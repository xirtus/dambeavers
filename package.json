{
  "name": "dambeavers",
  "version": "0.0.0",
  "private": true,
  "description": "Damn Beavers \u2014 a systemic beaver-civilization simulator.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
