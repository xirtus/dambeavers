    "check:save-load": "node tools/visual/save-load-check.mjs",
    "check:picking": "node tools/visual/picking-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.0",
    "puppeteer": "^25.8.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}